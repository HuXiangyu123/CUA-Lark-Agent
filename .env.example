# Lark CUA Agent - Environment Configuration
# Copy this file to .env and fill in your credentials.

# ---------------------------------------------------------------------------
# Lark CLI credentials
# ---------------------------------------------------------------------------
# Used by the API route. The Windows GUI route can run without these if you
# only test screenshot + mouse/keyboard automation.
LARKSUITE_CLI_APP_ID=
LARKSUITE_CLI_APP_SECRET=
LARKSUITE_CLI_BRAND=lark

# ---------------------------------------------------------------------------
# Chat / API model
# ---------------------------------------------------------------------------
# Used by the terminal chat path and API route.
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# ---------------------------------------------------------------------------
# GUI / VLM execution
# ---------------------------------------------------------------------------
# Preferred GUI-specific model configuration. The model must support images.
# For OpenAI-compatible providers that use the Responses API, the code uses
# streaming Responses requests for image understanding.
GUI_VLM_MODEL=
GUI_VLM_API_BASE=
GUI_VLM_API_KEY=

# Target desktop app name for GUI mode. On Windows, Feishu can also appear as
# the Chinese window title "飞书"; both are supported by the window matcher.
GUI_TARGET_APP=Feishu

# GUI loop controls.
GUI_MAX_STEPS=12
GUI_ACTION_PAUSE=0.5
GUI_STATE_DEBOUNCE=2
GUI_MIN_PERCEPTION_CONFIDENCE=0.25
GUI_VLM_TIMEOUT_SECONDS=90
GUI_CLEAR_MAX_DELETE_ATTEMPTS=3
GUI_ENABLE_EMOJI_HEURISTIC=0
GUI_DRY_RUN=0
GUI_TRACE_DIR=traces

# Compatibility aliases for the GUI route. Leave empty unless needed.
# Resolution order is GUI_VLM_* -> VLM_* -> OPENAI_*.
VLM_MODEL=
VLM_API_BASE=
VLM_API_KEY=

# Legacy compatibility keys. Leave empty unless an older script still depends
# on them.
CUA_MODEL=
CUA_API_BASE=
CUA_API_KEY=
CUA_TARGET_APP=
CUA_MAX_STEPS=
CUA_ACTION_PAUSE=
CUA_DRY_RUN=
CUA_TRACE_DIR=

# ---------------------------------------------------------------------------
# OCR execution
# ---------------------------------------------------------------------------
# Reserved for future integration. Current code does not invoke OCR.
OCR_ENABLED=0
OCR_PROVIDER=
OCR_MODEL=
OCR_API_BASE=
OCR_API_KEY=

# Lark CUA Agent — Environment Configuration
# Copy this file to .env and fill in your credentials

# ── Lark CLI credentials ──────────────────────────────────────
# Set by running: lark-cli config init --new
# Or manually export these before running the agent
LARKSUITE_CLI_APP_ID=
LARKSUITE_CLI_APP_SECRET=
LARKSUITE_CLI_BRAND=lark

# ── Chat / API model ─────────────────────────────────────────
# Used by the terminal chat path and API route.
OPENAI_API_BASE=https://api.openai.com/v1

# Your OpenAI API key
OPENAI_API_KEY=YOUR_API_KEY_HERE

# Model to use
OPENAI_MODEL=gpt-5.4

# ── GUI / VLM execution ──────────────────────────────────────
# Preferred GUI-specific model configuration.
GUI_VLM_MODEL=
GUI_VLM_API_BASE=
GUI_VLM_API_KEY=

# Compatibility alias keys for the GUI route. Leave empty if not needed.
# Resolution order is GUI_VLM_* -> VLM_* -> OPENAI_*.
# Optional multimodal model for GUI planning
VLM_MODEL=

# Optional dedicated API base/key for the GUI VLM
VLM_API_BASE=
VLM_API_KEY=

# Target desktop app name for GUI mode
GUI_TARGET_APP=Feishu

# ── OCR execution (optional, currently reserved) ──────────────
# Set OCR_ENABLED=1 after OCR integration is wired in code.
OCR_ENABLED=0

# OCR provider, for example: openai / qwen / custom
OCR_PROVIDER=

# OCR model name
OCR_MODEL=

# Optional dedicated API base/key for the OCR model
OCR_API_BASE=
OCR_API_KEY=

# GUI loop max steps
GUI_MAX_STEPS=12

# Pause between GUI actions in seconds
GUI_ACTION_PAUSE=0.5

# Number of repeated matching visual observations required before submit/done gates open
GUI_STATE_DEBOUNCE=2

# Set to 1 to enable the fixed emoji heuristic fallback
GUI_ENABLE_EMOJI_HEURISTIC=0

# Set to 1 to only simulate GUI actions without moving the mouse
GUI_DRY_RUN=0

# Trace directory for screenshots and reports
GUI_TRACE_DIR=traces

# Legacy compatibility keys. Leave empty unless an older script still depends on them.
CUA_MODEL=
CUA_API_BASE=
CUA_API_KEY=
CUA_TARGET_APP=
CUA_MAX_STEPS=
CUA_ACTION_PAUSE=
CUA_DRY_RUN=
CUA_TRACE_DIR=
